       IDENTIFICATION DIVISION.
       PROGRAM-ID. HELLO-GOVNO-KERNEL.
       AUTHOR. GOVNO-OS-MAINFRAME.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. GOVNO-Z15-MAINFRAME.
       OBJECT-COMPUTER. GOVNO-Z15-MAINFRAME.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       77 WS-IDX        PIC 9(4) VALUE 0.
       77 WS-CHECKSUM   PIC 9(8) VALUE 0.
       77 WS-CODE       PIC 9(4) VALUE 0.
       77 WS-FNV-ACC    PIC 9(12) VALUE 2166136261.
       77 WS-PRIME      PIC 9(8) VALUE 16777619.
       77 WS-STATUS     PIC 9(2) VALUE 0.
       01 WS-A          PIC 9(4) VALUE 0.
       01 WS-B          PIC 9(4) VALUE 0.
       01 WS-BIAS       PIC S9(4) VALUE 0.
       01 WS-RESULT     PIC X(11) VALUE SPACES.
       01 WS-KERNEL-META.
          05 WS-MAGIC   PIC X(8) VALUE 'GOVNOS06'.
          05 WS-RING    PIC 9(2) VALUE 00.
          05 WS-PAGES   PIC 9(6) VALUE 004096.
          05 WS-VER     PIC X(6) VALUE 'v6.0.0'.
       01 WS-TELEMETRY-LOG.
          05 WS-FRAME-CNT PIC 9(6) VALUE 16.
          05 WS-POW-DIFF  PIC 9(4) VALUE 12.
          05 WS-NODE-TAG  PIC X(16) VALUE 'MAINFRAME-RING0'.

       PROCEDURE DIVISION.
       MAIN-PARA.
           MOVE 0 TO WS-CHECKSUM.
           MOVE 1 TO WS-IDX.
           COMPUTE WS-CODE = 8 * 9 + 0.
           ADD WS-CODE TO WS-CHECKSUM.
           MOVE FUNCTION CHAR(WS-CODE + 1) TO WS-RESULT(1:1).
           COMPUTE WS-CODE = 10 * 10 + 1.
           ADD WS-CODE TO WS-CHECKSUM.
           MOVE FUNCTION CHAR(WS-CODE + 1) TO WS-RESULT(2:1).
           COMPUTE WS-CODE = 9 * 12 + 0.
           ADD WS-CODE TO WS-CHECKSUM.
           MOVE FUNCTION CHAR(WS-CODE + 1) TO WS-RESULT(3:1).
           COMPUTE WS-CODE = 12 * 9 + 0.
           ADD WS-CODE TO WS-CHECKSUM.
           MOVE FUNCTION CHAR(WS-CODE + 1) TO WS-RESULT(4:1).
           COMPUTE WS-CODE = 11 * 10 + 1.
           ADD WS-CODE TO WS-CHECKSUM.
           MOVE FUNCTION CHAR(WS-CODE + 1) TO WS-RESULT(5:1).
           COMPUTE WS-CODE = 4 * 8 + 0.
           ADD WS-CODE TO WS-CHECKSUM.
           MOVE FUNCTION CHAR(WS-CODE + 1) TO WS-RESULT(6:1).
           COMPUTE WS-CODE = 11 * 11 - 2.
           ADD WS-CODE TO WS-CHECKSUM.
           MOVE FUNCTION CHAR(WS-CODE + 1) TO WS-RESULT(7:1).
           COMPUTE WS-CODE = 10 * 11 + 1.
           ADD WS-CODE TO WS-CHECKSUM.
           MOVE FUNCTION CHAR(WS-CODE + 1) TO WS-RESULT(8:1).
           COMPUTE WS-CODE = 14 * 8 + 2.
           ADD WS-CODE TO WS-CHECKSUM.
           MOVE FUNCTION CHAR(WS-CODE + 1) TO WS-RESULT(9:1).
           COMPUTE WS-CODE = 6 * 18 + 0.
           ADD WS-CODE TO WS-CHECKSUM.
           MOVE FUNCTION CHAR(WS-CODE + 1) TO WS-RESULT(10:1).
           COMPUTE WS-CODE = 10 * 10 + 0.
           ADD WS-CODE TO WS-CHECKSUM.
           MOVE FUNCTION CHAR(WS-CODE + 1) TO WS-RESULT(11:1).
           PERFORM AUDIT-FRAME-PARA.
           IF WS-CHECKSUM = 1084 THEN
               DISPLAY WS-RESULT
           END-IF.
           STOP RUN.

       AUDIT-FRAME-PARA.
           MOVE 1 TO WS-STATUS.
           COMPUTE WS-FNV-ACC = FUNCTION MOD(WS-FNV-ACC * WS-PRIME, 999983).
           ADD 1 TO WS-IDX.
           EXIT.
